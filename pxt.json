{
    "name": "ble-beacon",
    "version": "0.0.1",
    "description": "Continuous Low Energy BLE Beacon Extension for micro:bit",
    "dependencies": {
        "core": "*"
    },
    "files": [
        "main.ts",
        "beacon.cpp",
        "README.md"
    ],
